{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build V2 (Release Win32)",
      "type": "shell",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
      "args": [
        "${workspaceFolder}\\V2.vcxproj",
        "/p:Configuration=Release",
        "/p:Platform=Win32",
        "/m"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compila el proyecto V2 en Release + Win32 (x86)."
    }
  ]
}
